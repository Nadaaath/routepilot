# =========================================================
# Node / JavaScript
# =========================================================

node_modules/
**/node_modules/

dist/
**/dist/

coverage/
**/coverage/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================================================
# Environment / secrets
# =========================================================

.env
.env.*
!.env.example

**/.env
**/.env.*
!**/.env.example

# =========================================================
# Prisma
# =========================================================

backend/src/generated/

# Keep Prisma migrations
!backend/prisma/migrations/

# =========================================================
# IDE / OS
# =========================================================

.vscode/
.idea/

.DS_Store
Thumbs.db

# =========================================================
# Terraform
# =========================================================

# Terraform working directory
**/.terraform/

# Terraform state
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved Terraform plans
*.tfplan

# Local-only Terraform files
infrastructure/terraform/*.local.tf

# Real variable values / secrets
*.tfvars
*.tfvars.json

# But keep examples
!*.tfvars.example
!*.tfvars.example.json

# Generated provider schema used for troubleshooting
provider-schema.json

# Terraform crash logs
crash.log
crash.*.log
# =========================================================
# Certificates / keys
# =========================================================

*.pem
*.key
*.crt
*.pfx

# =========================================================
# Temporary / backups
# =========================================================

*.bak
*.tmp
*~
