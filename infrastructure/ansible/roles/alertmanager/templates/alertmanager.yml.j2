global:
  resolve_timeout: 5m

  smtp_smarthost: "{{ alertmanager_smtp_smarthost }}"
  smtp_from: "{{ vault_alertmanager_smtp_from }}"
  smtp_auth_username: "{{ vault_alertmanager_smtp_auth_username }}"
  smtp_auth_password: "{{ vault_alertmanager_smtp_password }}"
  smtp_require_tls: true

route:
  receiver: "routepilot-email"

  group_by:
    - alertname
    - instance
    - service

  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: "routepilot-email"
    email_configs:
      - to: "{{ vault_alertmanager_email_to }}"
        send_resolved: true