global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:

  - job_name: "prometheus"
    static_configs:
      - targets:
          - "127.0.0.1:9090"

  - job_name: "node_exporter"
    static_configs:

      - targets:
          - "127.0.0.1:9100"
        labels:
          instance: "monitoring"

      - targets:
          - "10.100.1.10:9100"
        labels:
          instance: "frontend"

      - targets:
          - "10.100.2.10:9100"
        labels:
          instance: "backend"

      - targets:
          - "10.100.3.10:9100"
        labels:
          instance: "database"

  - job_name: "routepilot_backend"
    metrics_path: "/metrics"

    static_configs:
      - targets:
          - "10.100.2.10:8000"
        labels:
          component: "backend-api"