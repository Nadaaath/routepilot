global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:

  - job_name: "prometheus"
    static_configs:
      - targets:
          - "127.0.0.1:9090"

  - job_name: "node_exporter"
    static_configs:

      - targets:
          - "127.0.0.1:9100"
        labels:
          instance: "monitoring"

      - targets:
          - "10.100.1.10:9100"
        labels:
          instance: "frontend"

      - targets:
          - "10.100.2.10:9100"
        labels:
          instance: "backend"

      - targets:
          - "10.100.3.10:9100"
        labels:
          instance: "database"

  - job_name: "routepilot_backend"
    metrics_path: "/metrics"

    static_configs:
      - targets:
          - "10.100.2.10:8000"
        labels:
          component: "backend-api"

  - job_name: "cadvisor"
    static_configs:
      - targets:
          - "10.100.1.10:8080"
        labels:
          instance: "frontend"

      - targets:
          - "10.100.2.10:8080"
        labels:
          instance: "backend"

  - job_name: "postgresql"
    static_configs:
      - targets:
          - "10.100.3.10:9187"
        labels:
          instance: "database"
  - job_name: "blackbox_http"
    metrics_path: /probe

    params:
      module:
        - http_2xx

    static_configs:
      - targets:
          - "http://10.100.1.10/"
        labels:
          service: "frontend"

      - targets:
          - "http://10.100.2.10:8000/ready"
        labels:
          service: "backend"

    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target

      - source_labels: [__param_target]
        target_label: instance

      - target_label: __address__
        replacement: "127.0.0.1:9115"